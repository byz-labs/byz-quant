<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org"
    xmlns:xsi="http://w3.org"
    xsi:schemaLocation="http://apache.org https://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version> <!-- Java 26 uyumlu stabil Spring Boot sürümü -->

        <relativePath />
    </parent>

    <groupId>com.byzquant</groupId>
    <artifactId>fed-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>byz-quant-fed-service</name>
    <description>BYZ Quant FED Data Analysis Library</description>

    <properties>
        <java.version>26</java.version>
        <!-- JaCoCo sürümünü Java 26 bytecode (major 70) uyumlu sürüme yükselttik -->
        <jacoco.version>0.8.15</jacoco.version>
        <!-- Mockito'nun en güncel ve kararlı sürümünü zorunlu kılıyoruz -->
        <mockito.version>5.14.2</mockito.version>
        <sonar.sources>src/main/java</sonar.sources>
        <sonar.tests>src/test/java</sonar.tests>
        <sonar.java.binaries>target/classes</sonar.java.binaries>
        <sonar.organization>byz-labs</sonar.organization>
        <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <!-- Spring Boot Temel Bağımlılıkları -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- WebClient ve fonksiyonel HTTP çağrıları için gerekli reaktif bağımlılık -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <!-- Testler sırasında gerçek DB yerine hafızada çalışacak izole DB -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Veritabanı Sürücüsü -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- TEST BAĞIMLILIKLARI (TDD için Vazgeçilmezler) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MacOS Apple Silicon (M serisi) mimarisinde yerel DNS çözücü hatasını gideren
        düzeltilmiş bağımlılık -->
        <!-- Apple Silicon Mac'lerde Rosetta gerektirmeden yerel çalışan kararlı DNS çözücü -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-resolver-dns-native-macos</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- JPA Test anotasyonları ve H2/PostgreSQL test otomasyonları için gerekli bağımlılık -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test-autoconfigure</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4.x Modüler JPA Test Starter Paketi -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency><!-- Spring Boot 4.x Modüler Web/MVC Test
        Altyapısı -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JSON ve Java Nesneleri Arasındaki snake_case/camelCase Dönüşümleri İçin -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <!-- Sürüm numarasını sildik çünkü Spring Boot Parent bunu otomatik yönetir -->
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>3.11.0.3922</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version> <!-- Java 26 ve Spring Boot 4.x ile tam uyumlu güncel sürüm -->
                <executions>
                    <!-- 1. Testler koşarken arka planda veri toplayacak ajanı hazırlar -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- 2. Testler bittiği an Sonar'ın okuyacağı o jacoco.xml raporunu üretir -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version> <!-- Güncel ve kararlı sürüm -->
                <configuration>
                    <!-- KESİN ÇÖZÜM: JaCoCo ajanının topladığı test verilerini surefire
                    koşturucusuna aktaran kritik satır -->
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>